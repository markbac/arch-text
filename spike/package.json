{
  "name": "arch-text-spike",
  "private": true,
  "type": "module",
  "description": "Phase 1 spike (#2): Excalidraw in Node, text measurement, offline headless export.",
  "scripts": {
    "build:pages": "node build-page.mjs && node build-binding-page.mjs",
    "scene": "node make-scene.mjs",
    "node-import": "node node-import.mjs",
    "measure": "node measure.mjs",
    "export": "node export.mjs",
    "binding": "node binding.mjs",
    "all": "npm run build:pages && npm run scene && npm run node-import && npm run measure && npm run export && npm run binding"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.24.2",
    "fontkit": "2.0.4",
    "playwright-core": "1.63.0",
    "vite": "6.0.7"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.68.0"
  }
}
